{
  // Appflare + local unified install (SPA assets + share API on one Worker).
  // Production: Pages via apps/web, API via apps/worker/wrangler.jsonc — leave those alone.
  // Detected by Appflare "From a repository" (root wrangler required).
  "name": "mdviewer",
  "main": "scripts/appflare/entry.ts",
  "compatibility_date": "2024-01-01",
  "vars": {
    // After install: set to this Worker's origin (e.g. https://mdviewer.<account>.workers.dev).
    // Local `pnpm appflare:dev` defaults below match wrangler’s usual ports.
    "ALLOWED_ORIGINS": "http://127.0.0.1:8787,http://localhost:8787",
    "RATE_LIMIT_WINDOW": "60",
    "RATE_LIMIT_MAX_REQUESTS": "10"
  },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Gateway decides /api vs SPA; do not let assets claim /share before the Worker.
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "mdviewer"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ],
  "triggers": {
    "crons": ["0 4 * * *"]
  }
}
