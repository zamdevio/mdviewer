# Public build-time URLs for apps/web (NOT secrets).
# Same defaults are hardcoded as Vite fallbacks in apps/web/vite.config.ts.
# Override in .env.local, Cloudflare Pages, or GitHub Actions Variables.
# Users can also set a browser override under Settings → Share.
VITE_API_URL=https://api.mdviewer.zamdev.dev
VITE_FRONTEND_URL=https://mdviewer.zamdev.dev

# Backward-compatible aliases also accepted by vite.config.ts
# API_URL=https://api.mdviewer.zamdev.dev
# FRONTEND_URL=https://mdviewer.zamdev.dev
