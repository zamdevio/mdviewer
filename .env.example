# Used by apps/web (Vite). Cloudflare Pages can set the same keys without VITE_ prefix
# if you keep vite.config.ts define aliases — prefer VITE_* for clarity.
VITE_API_URL=https://api.mdviewer.zamdev.dev
VITE_FRONTEND_URL=https://mdviewer.zamdev.dev

# Backward-compatible aliases also accepted by vite.config.ts
# API_URL=https://api.mdviewer.zamdev.dev
# FRONTEND_URL=https://mdviewer.zamdev.dev
