# Repo-root env template for Appflare / wrangler discoverability.
#
# Do NOT put VITE_* here — Appflare treats every NAME= line in this file as a
# Worker secret on install. SPA build-time URLs live in apps/web/.env.example.
#
# Local unified Worker (optional override for CORS while developing):
#   cp .env.example .dev.vars
#   then set ALLOWED_ORIGINS to http://127.0.0.1:8787,http://localhost:8787
#
# Appflare fills {{appUrl}} in wrangler.jsonc vars on install/update — prefer that
# for ALLOWED_ORIGINS instead of baking localhost into production installs.

# Optional — only if you use a root .dev.vars for `pnpm appflare:dev`
# ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
