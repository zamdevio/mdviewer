{
  // Appflare-only Worker config. Production deploy still uses apps/worker/wrangler.jsonc.
  // No custom routes; installer sets ALLOWED_ORIGINS (and Appflare names the R2 bucket).
  "name": "mdviewer",
  "main": "../../apps/worker/src/index.ts",
  "compatibility_date": "2024-01-01",
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:3000",
    "RATE_LIMIT_WINDOW": "60",
    "RATE_LIMIT_MAX_REQUESTS": "10"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "mdviewer"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ],
  "triggers": {
    "crons": ["0 4 * * *"]
  }
}
