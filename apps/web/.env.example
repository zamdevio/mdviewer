# Public build-time URLs for the SPA (NOT secrets).
# Used by `pnpm web:dev` / Pages / GitHub Actions — not by Appflare unified builds
# (`pnpm appflare:build` injects VITE_API_URL=/api and VITE_FRONTEND_URL=same-origin).
#
# Keep these out of the repo-root `.env.example`: Appflare "from a repository"
# treats root `.env.example` NAME= lines as Worker secrets on the install form.
VITE_API_URL=https://api.mdviewer.zamdev.dev
VITE_FRONTEND_URL=https://mdviewer.zamdev.dev

# Backward-compatible aliases also accepted by vite.config.ts
# API_URL=https://api.mdviewer.zamdev.dev
# FRONTEND_URL=https://mdviewer.zamdev.dev
