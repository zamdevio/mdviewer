/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.zamdev.workers.dev https://*.zamdev.dev https://*.pages.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin

# SPA shell must never sit in CDN for a week (stale Next HTML was served on /settings)
/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

/settings
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

/settings/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

/editor
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

/files
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

/search
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

/shares
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

/share/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

/sw.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
