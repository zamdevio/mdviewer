{
  "name": "@mdviewer/worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Workers API for markdown sharing (Hono + OpenAPI).",
  "scripts": {
    "generate:llms": "node scripts/generate-llms-content.mjs",
    "predev": "pnpm run generate:llms",
    "predeploy": "pnpm run generate:llms",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "pnpm run generate:llms && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^0.19.10",
    "hono": "^4.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.54.0"
  }
}
