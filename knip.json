{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "apps/web": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/worker": {
      "entry": ["src/**/*.test.ts", "scripts/**/*.{js,mjs}"],
      "project": ["src/**/*.ts", "scripts/**/*.{js,mjs}"]
    }
  }
}
