{
  "name": "mdviewer",
  "private": true,
  "version": "3.8.0",
  "description": "Modern markdown viewer — Vite SPA + Cloudflare Workers share API.",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "web:dev": "pnpm --filter @mdviewer/web dev",
    "web:build": "pnpm --filter @mdviewer/web build",
    "web:preview": "pnpm --filter @mdviewer/web preview",
    "web:deploy": "pnpm --filter @mdviewer/web deploy",
    "worker:dev": "pnpm --filter @mdviewer/worker dev",
    "worker:deploy": "pnpm --filter @mdviewer/worker deploy",
    "worker:typecheck": "pnpm --filter @mdviewer/worker typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
